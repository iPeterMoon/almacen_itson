# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.
NODE_ENV=development
PUERTO=3000
# URL y clave publicable (anon) del proyecto de Supabase "almacenes-itson".
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=<clave-publicable>
# Orígenes permitidos para CORS, separados por coma (vacío = ninguno).
CORS_ORIGENES=
